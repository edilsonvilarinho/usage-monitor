# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Gere qualquer um dos segredos abaixo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Todos exigem no minimo 32 caracteres; abaixo disso o servidor recusa subir.

# Token de administracao. Com ele o app desktop emite as chaves de cada conta e
# abre a visao de todas as contas do servidor. Presente, monta as rotas
# /api/admin/*; ausente, elas nem existem.
TEAM_ADMIN_TOKEN=

# Segredo que cifra as chaves emitidas em repouso, para o painel poder re-exibi-las.
# Obrigatorio quando TEAM_ADMIN_TOKEN esta definida.
# Perde-lo NAO derruba nenhum cliente (a autenticacao usa hash) — apenas torna as
# chaves ilegiveis no painel, e o conserto e regera-las.
TEAM_KEY_SECRET=

# Chave unica compartilhada — LEGADA. Opcional desde que TEAM_ADMIN_TOKEN exista.
# Enquanto TEAM_LEGACY_KEY_MODE=open ela le QUALQUER conta: e o comportamento
# anterior, preservado para nao cortar quem ja usava.
TEAM_API_KEY=

# open  = a chave legada acima continua valendo para todas as contas (default)
# off   = a chave legada e rejeitada; so valem as chaves emitidas por conta
# Trocar para "off" e o passo que efetiva o isolamento entre times. Faca isso
# depois de emitir as chaves e atualizar os clientes.
TEAM_LEGACY_KEY_MODE=open

# Credencial de LEITURA GLOBAL, para o consumidor externo de relatorio.
# Le /api/v1/pricing, /api/v1/report/* e a visao agregada, em qualquer conta e
# sem chave de time. Nao escreve nada: ingest, presenca e todos os DELETE a
# recusam com 401 — o portao deles continua sendo TEAM_ADMIN_TOKEN.
# Opcional, e NAO conta como o segredo obrigatorio: um servidor que so publica
# relatorio e nao aceita cliente nenhum nao tem o que relatar.
# Rotacao = trocar o valor e redeployar.
TEAM_REPORT_TOKEN=

# Porta HTTP. No Dokploy deixe 3000 e exponha pelo proxy.
PORT=3000

# Diretorio do SQLite. No container e /data, montado como volume.
DATA_DIR=./data

# Horizonte de retencao dos turnos, em dias. O filtro mais largo da UI e 30
# dias; o default deixa folga para relogios adiantados.
TEAM_RETENTION_DAYS=45

# Teto de turnos (e de sessoes) por requisicao de ingest. Define o tamanho do
# lote de backfill que o cliente pode enviar de uma vez.
TEAM_MAX_TURNS_PER_REQUEST=5000

# Teto de series expostas em /metrics. Acima dele o rotulo de modelo e agregado
# fora e usage_monitor_metrics_model_label_dropped vai a 1 — degradar com sinal,
# em vez de truncar em silencio ou derrubar o scrape inteiro.
TEAM_METRICS_MAX_SERIES=20000

# Quantos proxies reversos ha na frente. 0 em execucao direta, 1 atras do
# Traefik do Dokploy.
TRUST_PROXY_HOPS=0

# trace | debug | info | warn | error | silent
LOG_LEVEL=info
