# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Chave compartilhada do time. Todo cliente do Usage Monitor precisa cola-la nas
# Configuracoes -> Integracao com time. Minimo 32 caracteres; abaixo disso o
# servidor recusa subir.
# Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TEAM_API_KEY=

# Porta HTTP. No Dokploy deixe 3000 e exponha pelo proxy.
PORT=3000

# Diretorio do SQLite. No container e /data, montado como volume.
DATA_DIR=./data

# Horizonte de retencao dos turnos, em dias. O filtro mais largo da UI e 30
# dias; o default deixa folga para relogios adiantados.
TEAM_RETENTION_DAYS=45

# Teto de turnos (e de sessoes) por requisicao de ingest. Define o tamanho do
# lote de backfill que o cliente pode enviar de uma vez.
TEAM_MAX_TURNS_PER_REQUEST=5000

# Quantos proxies reversos ha na frente. 0 em execucao direta, 1 atras do
# Traefik do Dokploy.
TRUST_PROXY_HOPS=0

# trace | debug | info | warn | error | silent
LOG_LEVEL=info
