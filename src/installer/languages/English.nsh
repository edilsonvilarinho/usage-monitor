!insertmacro LANGFILE_SECTION "English" "English"

!insertmacro LANGFILE_STRING "ProductName" "Usage Monitor"
!insertmacro LANGFILE_STRING "WelcomePage.Text" "Welcome to the $(^Name) Setup Wizard.$\r$\n$\r$\nThis will install $(^Name) on your computer.$\r$\n$\r$\nClick 'Next' to continue."
