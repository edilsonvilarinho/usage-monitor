!insertmacro LANGFILE_STRING "DirectoryPage.Text" "Choose the installation folder."
!insertmacro LANGFILE_STRING "ComponentsPage.Text" "Select the components to install."
!insertmacro LANGFILE_STRING "FinishedPage.Text" "$(^Name) has been installed on your computer.$(^FontHeight)$\r$\n$\r$\nClick 'Finish' to close the wizard."
!insertmacro LANGFILE_STRING "UninstallPage.Text" "Are you sure you want to remove $(^Name) from your computer?"
!insertmacro LANGFILE_STRING "FileError" "Could not write to file:$\r$\n$\r$\n$0"
!insertmacro LANGFILE_STRING "FileWriteError" "Error writing file: $0"
!insertmacro LANGFILE_STRING "InstallAborted" "Installation aborted!"
!insertmacro LANGFILE_STRING "UninstallAborted" "Uninstallation aborted!"
!insertmacro LANGFILE_STRING "ExitSetupTitle" "Exit Setup"
!insertmacro LANGFILE_STRING "ExitSetupText" "Are you sure you want to exit setup?"