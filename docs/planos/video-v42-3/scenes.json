    {
      "id": "title",
      "kind": "title",
      "headline": {
        "en": "Your accounts, in orbit",
        "pt": "Suas contas, em órbita"
      },
      "lines": {
        "en": {
          "text": "Usage Monitor 42.3. Your AI accounts, now in orbit.",
          "say": "Usage Monitor forty-two point three. Your AI accounts, now in orbit."
        },
        "pt": {
          "text": "Usage Monitor 42.3. Suas contas de IA, agora em órbita.",
          "say": "Usage Monitor quarenta e dois ponto três. Suas contas de IA, agora em órbita."
        }
      }
    },
    {
      "id": "minimize",
      "kind": "screen",
      "frames": "minimize",
      "tag": "#576",
      "kicker": {
        "en": "hud",
        "pt": "hud"
      },
      "headline": {
        "en": "Minimize to the black hole",
        "pt": "Minimize para o buraco negro"
      },
      "lines": {
        "en": [
          {
            "at": 0,
            "text": "Too many accounts on the bar? Open one and press minimize."
          },
          {
            "at": 6,
            "text": "It falls into the black hole, out of your way."
          },
          {
            "at": 11,
            "text": "Hover the hole. You will see every minimized account."
          },
          {
            "at": 20,
            "text": "Pick one to check it, then press plus to bring it back."
          }
        ],
        "pt": [
          {
            "at": 0,
            "text": "Contas demais na barra? Abra uma e toque em minimizar."
          },
          {
            "at": 6,
            "text": "Ela cai no buraco negro e sai do caminho."
          },
          {
            "at": 11,
            "text": "Passe o mouse no buraco para ver as contas minimizadas."
          },
          {
            "at": 20,
            "text": "Escolha uma para conferir e toque em mais para trazer de volta."
          }
        ]
      },
      "crop": [
        180,
        120,
        2470,
        1710
      ],
      "focus": [
        970,
        1475,
        140,
        135
      ],
      "focusAt": 4.3,
      "surface": "hud"
    },
    {
      "id": "floating",
      "kind": "screen",
      "frames": "floating",
      "tag": "#619",
      "kicker": {
        "en": "hud",
        "pt": "hud"
      },
      "headline": {
        "en": "A floating HUD",
        "pt": "A HUD flutuante"
      },
      "lines": {
        "en": [
          {
            "at": 0,
            "text": "In floating mode, the HUD rests as a black hole, anywhere on screen."
          },
          {
            "at": 5.5,
            "text": "Point at it. Your accounts open in a column, right beside it."
          }
        ],
        "pt": [
          {
            "at": 0,
            "text": "No modo flutuante, a HUD descansa como um buraco negro, em qualquer lugar da tela."
          },
          {
            "at": 5.5,
            "text": "Aponte para ele e as contas se abrem numa coluna ao lado."
          }
        ]
      },
      "crop": [
        0,
        0,
        1008,
        2068
      ],
      "surface": "hud"
    },
    {
      "id": "reorder",
      "kind": "screen",
      "frames": "reorder",
      "tag": "#584",
      "kicker": {
        "en": "hud",
        "pt": "hud"
      },
      "headline": {
        "en": "Drag to reorder",
        "pt": "Arraste para reordenar"
      },
      "lines": {
        "en": [
          {
            "at": 0,
            "text": "Want your main account first?",
            "say": "Want your main account... first?"
          },
          {
            "at": 4.5,
            "text": "Hold its ring and drag it into place. The new order is saved."
          }
        ],
        "pt": [
          {
            "at": 0,
            "text": "Quer a conta principal primeiro?",
            "say": "Quer a conta principal... primeiro?"
          },
          {
            "at": 4.5,
            "text": "Segure o anel e arraste até o lugar. A nova ordem fica salva."
          }
        ]
      },
      "crop": [
        180,
        120,
        2420,
        1370
      ],
      "surface": "hud"
    },
