        "pt": "Sessões do Codex, como no Claude"
      },
      "lines": {
        "en": [
          {
            "at": 0,
            "text": "Codex sessions now open like Claude's, with tokens and models."
          },
          {
            "at": 5,
            "text": "One click copies the resume command. Done."
          }
        ],
        "pt": [
          {
            "at": 0,
            "text": "As sessões do Codex agora abrem como as do Claude, com tokens e modelos."
          },
          {
            "at": 5,
            "text": "Um clique copia o comando para retomar a sessão."
          }
        ]
      },
